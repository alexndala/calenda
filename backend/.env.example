# Production CORS: comma-separated list of allowed frontend origins
# Example: https://calenda-frontend.up.railway.app
CORS_ORIGINS=

# Alpha Vantage API key (optional — IPO calendar only)
# Free tier: 25 requests/day
# Get yours at: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_KEY=

# Source routing (defaults shown)
# Price/events backbone: yfinance
# Fundamentals in on-demand detail endpoint: OpenBB (US only)
# IPO calendar: Alpha Vantage
PRICE_PROVIDER=yfinance
FUNDAMENTALS_PROVIDER=openbb
IPO_PROVIDER=alphavantage
